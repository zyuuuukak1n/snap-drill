# ==============================================================================
# SnapDrill (スナップドリル) - Environment Variables Template
# ==============================================================================

# Google Gemini API Key (Required for /api/extract-test)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# App URL / Base URL (Optional, defaults to request origin or https://snap-drill.zyuuuukak1n.dev)
NEXT_PUBLIC_APP_URL=https://snap-drill.zyuuuukak1n.dev

# Node Environment
NODE_ENV=production

